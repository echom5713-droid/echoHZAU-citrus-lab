# Optional local settings. No deployed credentials are included.
PORT=3000
# Leave both key variables empty to use the built-in local teaching responses.
DEEPSEEK_API_KEY=
LLM_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_TIMEOUT_MS=20000
DEEPSEEK_MAX_TOKENS=900
# Export storage/session settings in your shell BEFORE starting Node.
# STORAGE_MODE=json selects JSON fallback; empty selects SQLite when available.
STORAGE_MODE=
SESSION_TTL_MS=86400000
LOGIN_WINDOW_MS=600000
LOGIN_MAX_ATTEMPTS=8
